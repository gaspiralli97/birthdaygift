# Copy to .env for development. On the server these live in
# /etc/birthdaygift/env, loaded by systemd. Never commit a filled-in copy.

# Origin used to build card links and absolute OG image URLs.
SITE_URL=http://localhost:8000

# SQLite file. The deploy script points this at /var/lib/birthdaygift.
DATABASE_PATH=./data/birthdaygift.db

# How long a card link stays alive.
CARD_TTL_DAYS=5

# Letter text. "template" needs no key and costs nothing.
TEXT_PROVIDER=template

# Telegram. Empty disables the bot; the card pages still work.
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes back on every webhook call, so the endpoint
# can reject anything that did not come from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Abuse limits
RATE_PER_IP_PER_DAY=5
RATE_PER_TELEGRAM_USER_PER_DAY=3
RATE_GLOBAL_PER_DAY=200
