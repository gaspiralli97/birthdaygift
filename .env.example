# Copy to .env for development. On the server these live in
# /etc/birthdaygift/env, loaded by systemd. Never commit a filled-in copy.

# Origin used to build card links and the absolute preview-image URL.
SITE_URL=http://localhost:8000

DATABASE_PATH=./data/birthdaygift.db
CARD_TTL_DAYS=5

# The Claude Code CLI writes the letters, authenticating with the account it
# was logged in with rather than a metered API key. Run `claude setup-token`
# once on the host. Without it the bot falls back to asking the sender to
# write the letter themselves.
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
LETTER_MIN_WORDS=60
LETTER_MAX_WORDS=110

# From @BotFather. Empty disables the bot; card pages keep working.
TELEGRAM_BOT_TOKEN=
# Any random string. Telegram echoes it back on every webhook call, and the
# endpoint refuses anything that does not carry it.
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram id. Both usage reports are delivered here; empty disables them.
TELEGRAM_OWNER_ID=

# Cards per digest. The weekly report covers whatever is left over.
REPORT_EVERY=10

# Every letter is a CLI session drawn from one subscription, so the bot caps
# what one person - and everyone together - can spend in a rolling day.
RATE_PER_USER_PER_DAY=5
RATE_GLOBAL_PER_DAY=60
