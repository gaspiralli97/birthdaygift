# Copy to .env (or /etc/birthdaygift/env on the server) and fill in.
# Never commit the filled-in file.

PORT=3000
PUBLIC_URL=https://151-145-79-228.sslip.io
DATA_DIR=./data
CARD_TTL_DAYS=5

# Text generation. "none" = built-in template, no API key needed.
# Switch to "anthropic" once a key is in place.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Telegram bot (optional). Empty = bot disabled, web form only.
TELEGRAM_BOT_TOKEN=

# Abuse limits
RATE_PER_USER_PER_DAY=3
RATE_GLOBAL_PER_DAY=100
