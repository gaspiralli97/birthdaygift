[Unit]
Description=Run the birthdaygift health check every 15 minutes
Documentation=https://github.com/gaspiralli97/birthdaygift

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
# A fixed cadence would put every check on the quarter hour; the jitter keeps
# the CLI call off the same second as everybody else's cron.
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
